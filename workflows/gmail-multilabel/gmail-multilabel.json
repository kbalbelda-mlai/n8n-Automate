    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst output = [];\n\nfor (let itemIndex = 0; itemIndex < items.length; itemIndex++) {\n  const item = items[itemIndex];\n  const binary = item.binary ?? {};\n\n  // Existing names already stored in this sender folder.\n  // Use lowercase comparisons to avoid visually confusing\n  // collisions such as Sample.pdf vs sample.pdf.\n  const usedNames = new Set(\n    (item.json.existing_file_names ?? [])\n      .map(name => String(name).toLowerCase())\n  );\n\n  const attachmentKeys = Object.keys(binary)\n    .filter(key => key.startsWith('attachment_'))\n    .sort((a, b) => {\n      const aIndex = Number(a.replace('attachment_', ''));\n      const bIndex = Number(b.replace('attachment_', ''));\n      return aIndex - bIndex;\n    });\n\n  for (\n    let attachmentIndex = 0;\n    attachmentIndex < attachmentKeys.length;\n    attachmentIndex++\n  ) {\n    const attachmentKey = attachmentKeys[attachmentIndex];\n    const file = binary[attachmentKey];\n\n    const originalFileName = file.fileName ?? attachmentKey;\n\n    // Separate filename stem and extension.\n    const lastDot = originalFileName.lastIndexOf('.');\n    const hasExtension = lastDot > 0;\n\n    const baseName = hasExtension\n      ? originalFileName.slice(0, lastDot)\n      : originalFileName;\n\n    const extension = hasExtension\n      ? originalFileName.slice(lastDot)\n      : '';\n\n    let storedFileName = originalFileName;\n    let suffix = 2;\n\n    // If the name already exists, generate _2, _3, _4, ...\n    while (usedNames.has(storedFileName.toLowerCase())) {\n      storedFileName = `${baseName}_${suffix}${extension}`;\n      suffix++;\n    }\n\n    // Reserve the selected name so two attachments in the\n    // SAME email also can't receive the same final filename.\n    usedNames.add(storedFileName.toLowerCase());\n\n    output.push({\n      json: {\n        message_id: item.json.message_id,\n        received_timestamp: item.json.received_timestamp,\n        sender_name: item.json.sender_name,\n        sender_email: item.json.sender_email,\n        subject: item.json.subject,\n        matched_label: item.json.matched_label,\n        has_attachment: item.json.has_attachment,\n        attachment_count: item.json.attachment_count,\n\n        sender_folder_id: item.json.sender_folder_id,\n\n        drive_folder:\n          `attachments/${item.json.matched_label}/${item.json.received_timestamp.slice(0, 10)}/${item.json.sender_name}`,\n\n        processing_status: item.json.processing_status,\n\n        attachment_index: attachmentIndex,\n        attachment_key: attachmentKey,\n\n        original_file_name: originalFileName,\n        file_name: storedFileName,\n\n        mime_type: file.mimeType ?? '',\n        file_extension: file.fileExtension ?? '',\n        file_size: file.fileSize ?? null\n      },\n\n      binary: {\n        data: file\n      },\n\n      pairedItem: {\n        item: itemIndex\n      }\n    });\n  }\n}\n\nreturn output;"
      },
