        720
      ],
      "id": "fdf36e42-787f-4862-93a6-a11305fce201",
      "name": "restore_receipt_context"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nreturn items.map((item, index) => {\n  const j = item.json;\n  const message = j.message ?? {};\n\n  // Helper: considers 0 a valid value, but null/undefined/blank invalid.\n  const isPresent = (value) => {\n    if (value === null || value === undefined) return false;\n    return String(value).trim() !== '';\n  };\n\n  // Employer-required core receipt fields.\n  const coreFields = {\n    merchant_name: j.merchant_name,\n    receipt_date: j.receipt_date,\n    total_amount: j.total_amount,\n  };\n\n  const coreFieldsFound = Object.values(coreFields)\n    .filter(isPresent)\n    .length;\n\n  let qualityStatus;\n\n  // Clearly unusable / invalid cases.\n  if (\n    j.parse_success !== true ||\n    j.is_receipt !== true ||\n    j.legibility === 'unreadable' ||\n    coreFieldsFound <= 1\n  ) {\n    qualityStatus = 'UNRECOGNIZABLE';\n  }\n\n  // Meaningful extraction exists, but something important is uncertain.\n  else if (\n    j.legibility === 'partial' ||\n    coreFieldsFound === 2\n  ) {\n    qualityStatus = 'REVIEW_REQUIRED';\n  }\n\n  // All core fields present and image judged clear.\n  else {\n    qualityStatus = 'SUCCESS';\n  }\n\n  // Telegram timestamp → Philippine local time.\n  // Philippines is UTC+8 and has no DST.\n  const telegramUnixSeconds = Number(message.date ?? 0);\n  const phDate = new Date((telegramUnixSeconds + (8 * 60 * 60)) * 1000);\n\n  const submissionTimestamp = phDate\n    .toISOString()\n    .slice(0, 19)\n    .replace('T', ' ');\n\n  const submissionDate = submissionTimestamp.slice(0, 10);\n\n  const chatId = message.chat?.id ?? '';\n  const messageId = message.message_id ?? '';\n\n  const submissionId =\n    `${String(chatId)}_${String(messageId)}`;\n\n  const telegramUser =\n    message.from?.username ||\n    [message.from?.first_name, message.from?.last_name]\n      .filter(Boolean)\n      .join(' ') ||\n    String(chatId);\n\n  // Telegram photos do not have a meaningful original filename,\n  // so create a deterministic unique storage name.\n  const driveFileName =\n    `receipt_${submissionId}.jpg`;\n\n  return {\n    json: {\n      // Submission metadata\n      submission_id: submissionId,\n      submission_timestamp: submissionTimestamp,\n      submission_date: submissionDate,\n      telegram_user: telegramUser,\n      telegram_chat_id: chatId,\n\n      // Extracted receipt fields\n      merchant_name: j.merchant_name ?? null,\n      receipt_date: j.receipt_date ?? null,\n      receipt_time: j.receipt_time ?? null,\n      receipt_number: j.receipt_number ?? null,\n      total_amount: j.total_amount ?? null,\n      currency: j.currency ?? null,\n      merchant_tin: j.merchant_tin ?? null,\n      merchant_address: j.merchant_address ?? null,\n      vat_amount: j.vat_amount ?? null,\n      discount_amount: j.discount_amount ?? null,\n      payment_method: j.payment_method ?? null,\n\n      // Quality / audit information\n      parse_success: j.parse_success === true,\n      is_receipt: j.is_receipt === true,\n      legibility: j.legibility ?? 'unreadable',\n      extraction_notes: j.extraction_notes ?? null,\n      core_fields_found: coreFieldsFound,\n      quality_status: qualityStatus,\n      prompt_source: j.prompt_source ?? 'unknown',\n\n      // Storage fields used later\n      drive_file_name: driveFileName,\n      drive_file: '',\n\n      // Will be finalized after Drive + Sheets processing\n      processing_status: 'EXTRACTED'\n    },\n\n    // Preserve original Telegram receipt photo\n    binary: item.binary,\n\n    pairedItem: {\n      item: index\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
