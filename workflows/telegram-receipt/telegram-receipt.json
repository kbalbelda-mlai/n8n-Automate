      "name": "merge_prompt_context"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nreturn items.map((item, index) => {\n  try {\n    // Locate Gemini's text response\n    const rawText =\n      item.json.content?.parts?.find(\n        part => typeof part.text === 'string'\n      )?.text ?? '';\n\n    // Be tolerant if Gemini ever adds Markdown fences\n    const cleanedText = rawText\n      .trim()\n      .replace(/^```(?:json)?\\s*/i, '')\n      .replace(/\\s*```$/i, '')\n      .trim();\n\n    if (!cleanedText) {\n      throw new Error('Gemini returned no receipt JSON text.');\n    }\n\n    const parsed = JSON.parse(cleanedText);\n\n    return {\n      json: {\n        parse_success: true,\n\n        is_receipt: parsed.is_receipt ?? false,\n        merchant_name: parsed.merchant_name ?? null,\n        receipt_date: parsed.receipt_date ?? null,\n        receipt_time: parsed.receipt_time ?? null,\n        receipt_number: parsed.receipt_number ?? null,\n        total_amount: parsed.total_amount ?? null,\n        currency: parsed.currency ?? null,\n        merchant_tin: parsed.merchant_tin ?? null,\n        merchant_address: parsed.merchant_address ?? null,\n        vat_amount: parsed.vat_amount ?? null,\n        discount_amount: parsed.discount_amount ?? null,\n        payment_method: parsed.payment_method ?? null,\n        legibility: parsed.legibility ?? 'unreadable',\n        extraction_notes: parsed.extraction_notes ?? null\n      },\n\n      pairedItem: {\n        item: index\n      }\n    };\n\n  } catch (error) {\n    return {\n      json: {\n        parse_success: false,\n\n        is_receipt: false,\n        merchant_name: null,\n        receipt_date: null,\n        receipt_time: null,\n        receipt_number: null,\n        total_amount: null,\n        currency: null,\n        merchant_tin: null,\n        merchant_address: null,\n        vat_amount: null,\n        discount_amount: null,\n        payment_method: null,\n        legibility: 'unreadable',\n        extraction_notes: `Gemini response could not be parsed: ${error.message}`\n      },\n\n      pairedItem: {\n        item: index\n      }\n    };\n  }\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -240,
        496
      ],
      "id": "f5f29bf1-568f-4435-a99c-b8c67ab4cb52",
      "name": "parse_receipt_output"
    },
    {
      "parameters": {
        "mode": "combine",
        "combineBy": "combineByPosition",
        "options": {}
      },
      "type": "n8n-nodes-base.merge",
